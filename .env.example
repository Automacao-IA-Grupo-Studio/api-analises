# ── Banco de dados (SQLite local — sem servidor externo) ──────────────────────
# Por padrão o banco fica em data/database.sqlite, ao lado do projeto (dev)
# ou ao lado do .exe (empacotado). Só defina DB_FILE se quiser um caminho
# diferente (ex.: um disco/pasta de rede específico).
# DB_FILE=C:\caminho\para\database.sqlite

# ── API ───────────────────────────────────────────────────────────────────────
PORT=3030

# ── Analisador de documentos ──────────────────────────────────────────────────
# Em produção (pacote empacotado) o server detecta automaticamente o
# analisar_job.exe ao lado do server.exe e usa ele — não precisa configurar nada.
# Em desenvolvimento (rodando "node server.js" direto), usa Python do sistema:
#   Windows: python   |   Linux/Mac: python3
# Só defina PYTHON_BIN se quiser forçar um caminho específico.
# PYTHON_BIN=python
