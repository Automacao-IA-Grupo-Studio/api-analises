# ── Banco de dados (MySQL, dentro do Docker — ver docker-compose.yml) ─────────
# A API roda FORA do Docker (via PM2), então conecta no MySQL como se fosse
# um banco externo normal: host + a porta publicada pelo docker-compose.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=api_analises
DB_USER=api_analises
DB_PASSWORD=api_analises
# Senha do usuário root do MySQL (só usada pelo docker-compose ao criar o
# container pela primeira vez). TROQUE antes de subir em produção.
DB_ROOT_PASSWORD=troque_esta_senha

# ── API ───────────────────────────────────────────────────────────────────────
PORT=3030

# ── Analisador de documentos ──────────────────────────────────────────────────
# Em produção (pacote empacotado) o server detecta automaticamente o
# analisar_job.exe ao lado do executável e usa ele — não precisa configurar nada.
# Em desenvolvimento (rodando "node server.js" direto), usa Python do sistema:
#   Windows: python   |   Linux/Mac: python3
# Só defina PYTHON_BIN se quiser forçar um caminho específico.
# PYTHON_BIN=python

# Raiz de leitura para o seletor e a fila (acessível pelo usuário do servidor).
JOBS_ROOT=\\studiofiscal\Temporarios
# Entre 1 e 4 análises simultâneas.
JOBS_CONCURRENCY=2
