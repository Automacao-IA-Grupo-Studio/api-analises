{
  "name": "api-analises",
  "version": "2.0.0",
  "description": "API de análise de documentos — Studio Fiscal",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:server": "pkg . --targets node18-win-x64 --output dist/build/server.exe",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File build.ps1"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "frontend/**/*",
      "migrations/**/*",
      "node_modules/better-sqlite3/build/Release/*.node"
    ],
    "scripts": [
      "routes/**/*.js",
      "controllers/**/*.js",
      "db/**/*.js"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "@yao-pkg/pkg": "^5.14.0"
  }
}
